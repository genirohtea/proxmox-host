# Managed by Ansible (roles/telemetry_agent) -- local edits are overwritten.
#
# systemd reads these as PID 1 and exposes them under
# $CREDENTIALS_DIRECTORY, readable only by this service. The source file on
# disk stays 0600 root:root and the token never enters the process environment
# or rendered Alloy configuration.
#
# If the source file is missing, the unit fails to start rather than starting
# without an identity and failing every push instead.
[Service]
LoadCredential=telemetry-api-key:{{ telemetry_agent_api_key_path }}

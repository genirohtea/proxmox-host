# Managed by Ansible (roles/telemetry_agent) -- local edits are overwritten.
#
# This file holds no secrets. systemd hands the API key to Alloy through
# LoadCredential (see the alloy.service drop-in), not through the environment.

CONFIG_FILE="/etc/alloy/config.alloy"

# Loopback only. Alloy's HTTP server exposes the component graph and every
# configured endpoint's status -- there is no reason for it to answer the LAN.
# --disable-reporting suppresses usage telemetry to Grafana Labs.
CUSTOM_ARGS="--server.http.listen-addr={{ telemetry_agent_listen_address }} --disable-reporting"

RESTART_ON_UPGRADE=true
